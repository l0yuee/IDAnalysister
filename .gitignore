# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# IDA Pro databases and generated artifacts (matches regardless of the
# analyzed binary's basename, e.g. "whatever.exe.i64", "sample.idb", ...)
*.idb
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.asm.gen
*.dmp

# Ad-hoc analysis targets: binaries dropped into the project directory (or
# opened from it in IDA) while debugging against a real sample are not part
# of this project's source and must never be committed. Extension-based
# rules can't catch an extensionless sample, so prefer dropping such files
# under /samples/ (fully ignored below, any name/extension) instead of the
# repo root.
*.exe
*.dll
*.sys
*.bin
*.obj
/samples/

# Integration test fixture build artifacts (rebuilt on demand from .asm) —
# tests/integration/fixtures/*.asm sources ARE part of this project and stay
# tracked; only their compiled output is ignored.
tests/integration/fixtures/probe
tests/integration/fixtures/*.o

# Test / tooling caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
